$C = "Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 1060, Height: 660);

  #Title {
    Label #ShopTitle {
      Style: (
        ...$C.@TitleStyle,
        HorizontalAlignment: Center,
      );
      Padding: (Horizontal: 19);
      Text: "Outlander Armory";
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 10);

    Group #Header {
      Anchor: (Height: 44);
      LayoutMode: CenterMiddle;

      Label #MoneyLabel {
        Style: (
          FontSize: 22,
          TextColor: #e8c547,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
          RenderBold: true,
        );
        Text: "Team Money: $0";
      }
    }

    // Cards flow left to right; each catalog tier fills one row of six.
    Group #ItemGridContainer {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Top: 6, Left: 8, Right: 8);

      Group #ItemGrid {
        LayoutMode: LeftCenterWrap;
      }
    }

    Group #Footer {
      Anchor: (Height: 40);
      LayoutMode: Top;
      Padding: (Horizontal: -2);

      Group #FooterDivider {
        Anchor: (Height: 2);
        Background: #19252F;
      }

      Group #FooterContent {
        FlexWeight: 1;
        LayoutMode: CenterMiddle;
        Padding: (Bottom: 6);

        Label #StatusLabel {
          Style: (
            FontSize: 14,
            TextColor: #7caacc,
            HorizontalAlignment: Center,
            VerticalAlignment: Center,
          );
          Text: "Money is shared by the whole team. Earn more by killing wave mobs.";
        }
      }
    }
  }
}

$C.@BackButton {}
