$C = "Common.ui";

Group {
  LayoutMode: Top;

  // Thin single-row bar using the shop window's panel texture and ornaments.
  Group #WavePanel {
    Anchor: (Top: 14, Width: 330, Height: 52);
    Background: (TexturePath: "Common/ContainerPatch.png", Border: 23);

    // No LayoutMode here (as in @DecoratedContainer), so the ornaments are anchored
    // onto the edges instead of being stacked into the flow and pushing the row down.
    Group #DecorationTop {
      Anchor: (Width: 236, Height: 11, Top: -6);
      Background: "Common/ContainerDecorationTop.png";
    }

    Group #DecorationBottom {
      Anchor: (Width: 236, Height: 11, Bottom: -6);
      Background: "Common/ContainerDecorationBottom.png";
    }

    Group #Content {
      Anchor: (Full: 0);
      LayoutMode: CenterMiddle;

      Group #Row {
        LayoutMode: Left;

        Group #WaveIcon {
          Anchor: (Width: 26, Height: 26, Right: 8);
          Background: "CastleSiege/WaveIcon.png";
        }

        Label #WaveLabel {
          Style: (FontSize: 20, TextColor: #dde4ea, VerticalAlignment: Center, RenderBold: true);
          Text: "0 / 20";
        }

        Group #Divider1 {
          Anchor: (Width: 1, Height: 24, Left: 16, Right: 16);
          Background: #ffffff(0.18);
        }

        Group #MobIcon {
          Anchor: (Width: 26, Height: 26, Right: 8);
          Background: "CastleSiege/SkullIcon.png";
        }

        Label #MobsLabel {
          Style: (FontSize: 20, TextColor: #dde4ea, VerticalAlignment: Center, RenderBold: true);
          Text: "0";
        }

        Group #Divider2 {
          Anchor: (Width: 1, Height: 24, Left: 16, Right: 16);
          Background: #ffffff(0.18);
        }

        Label #MoneyLabel {
          Style: (FontSize: 20, TextColor: #e8c547, VerticalAlignment: Center, RenderBold: true);
          Text: "$0";
        }
      }
    }
  }
}
